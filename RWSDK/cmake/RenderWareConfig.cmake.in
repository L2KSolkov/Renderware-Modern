@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/RenderWareTargets.cmake")

# The SDK include directory (generated headers live alongside the source tree
# include dir); consumers may also use target properties.
set(RenderWare_INCLUDE_DIRS
    "@RW_SDK_INCDIR@"
    "${CMAKE_CURRENT_LIST_DIR}/../../../include")

check_required_components(RenderWare)
